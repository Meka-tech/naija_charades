{
  "expo": {
    "name": "naija_charades",
    "slug": "naija_charades",
    "version": "2.0.0",
    "scheme": "naija-charades",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow naija_charades to access your microphone to play game sounds."
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naijacharades.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.naijacharades.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e014c08-7d5c-4032-bcbe-3d12ddcd0c82"
      }
    },
    "owner": "meka1200",
    "runtimeVersion": "2.0.0",
    "updates": {
      "url": "https://u.expo.dev/9e014c08-7d5c-4032-bcbe-3d12ddcd0c82"
    }
  }
}
